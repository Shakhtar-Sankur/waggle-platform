<?xml version="1.0" encoding="utf-8"?>
<!--
    The launcher foreground: the waggle run.

    Same geometry as the web mark in src/components/Wordmark.tsx, drawn on the
    same 48-unit grid and then scaled into the 108dp adaptive-icon viewport.
    Keep the two in step — if the path data here and there ever diverge, the
    icon and the header stop being the same logo.

    Adaptive icons are masked to a circle, a squircle or a rounded square
    depending on the launcher, and only the middle 72 of the 108 is guaranteed
    to survive. The group below scales the 48-unit artwork by 1.95 and centres
    it, which keeps the drawing well inside the safe zone on every mask.

    Strokes and one fill, and so no <mask> anywhere. That is the point of this
    drawing on Android: VectorDrawable has NO <mask> element, so the previous
    hexagon mark could not be ported honestly — its stripes had to be repainted
    in the background colour to fake the cut-out, which meant the icon quietly
    stopped working the moment the background was anything but that exact
    indigo. This version is the same artwork in both places.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- scale about the origin, then translate. The artwork's centre on the
         48-grid is 24.6,24.1 (not 24,24 — the node pushes it right and up), so
         after the 1.95 scale it sits at 47.97,46.99 and needs +6.03,+7.01 to
         land at 54,54. Scaled size is 62x51.5, inside the 72 safe zone. -->
    <group
        android:scaleX="1.95"
        android:scaleY="1.95"
        android:translateX="6.03"
        android:translateY="7.01">

        <!-- A W drawn as a wave: the letter and the waggle are the same shape.
             Chosen over a bare diagonal wave because THIS is the size that
             decides an icon — at 40px the wave became an ambiguous squiggle
             closer to an S than to the app's name. -->
        <path
            android:pathData="M11,15 C 12.5,30 15,35 17.5,35 C 20,35 22.5,26 24,22 C 25.5,26 28,35 30.5,35 C 33,34 35,28 36,18"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="4.6"
            android:strokeLineCap="round" />

        <!-- The destination, on the end of the final upstroke. Drawn as two
             arcs because VectorDrawable has no <circle> element. -->
        <path
            android:pathData="M36.4,10.9 a4.1,4.1 0 1,1 0,8.2 a4.1,4.1 0 1,1 0,-8.2 Z"
            android:fillColor="#FFFFFF" />
    </group>
</vector>
