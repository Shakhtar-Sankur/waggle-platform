<?xml version="1.0" encoding="utf-8"?>
<!--
    The splash copy of the launcher mark.

    A second file purely because an <adaptive-icon> cannot point its foreground
    at an AnimatedVectorDrawable — the launcher needs a plain vector, so the
    animation cannot simply be added to ic_launcher_waggle.xml. This is that
    same artwork, arranged so avd_launcher_waggle.xml can animate it.

    Two differences from the static file, both required by the animation:

    1. The run starts with trimPathEnd="0", so nothing is drawn until the
       animation runs. If the AVD is ever removed this file renders EMPTY
       rather than wrong, which is the failure that gets noticed.

    2. The node lives in its OWN group with its own translate. A group is the
       only thing an AVD can move along a motion path, and a path cannot be
       moved by animating its pathData without redrawing it. So the node is
       drawn at the ORIGIN of its group and the group carries it — which means
       the circle below is centred on 0,0, not on 36.4,15 like the static
       version. The group's starting translate puts it at the run's first
       point.

    Any edit to the geometry has to be made in BOTH files, and in the web mark
    at src/components/Wordmark.tsx.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:name="dance"
        android:scaleX="1.95"
        android:scaleY="1.95"
        android:translateX="6.03"
        android:translateY="7.01">

        <!-- The W, drawn behind the travelling point. -->
        <path
            android:name="run"
            android:pathData="M11,15 C 12.5,30 15,35 17.5,35 C 20,35 22.5,26 24,22 C 25.5,26 28,35 30.5,35 C 33,34 35,28 36,18"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="4.6"
            android:strokeLineCap="round"
            android:trimPathEnd="0" />

        <!-- The point that draws it. Starts at the W's first point, 11,15. -->
        <group
            android:name="pinGroup"
            android:translateX="11"
            android:translateY="15">
            <path
                android:name="pin"
                android:pathData="M-4.1,0 a4.1,4.1 0 1,1 8.2,0 a4.1,4.1 0 1,1 -8.2,0 Z"
                android:fillColor="#FFFFFF" />
        </group>
    </group>
</vector>
