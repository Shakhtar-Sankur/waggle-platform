# Supabase (required for multi-user cloud mode)
# 1. Create a project at https://supabase.com
# 2. Run supabase/schema.sql in the SQL Editor
# 3. Copy Project URL and anon public key from Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Crash reporting (optional). Without it the app runs exactly as before and
# nothing is sent anywhere. Create a project at https://sentry.io and paste its
# DSN here. Phone numbers, GPS coordinates and message text are stripped before
# any event leaves the device — see src/services/Monitoring.ts.
VITE_SENTRY_DSN=

# Stamped onto crash reports so a bug can be tied to the build it came from.
VITE_APP_VERSION=1.2

# ── Map tiles ────────────────────────────────────────────────────────
# Unset, the app uses OpenStreetMap's own tiles: no key, no watermark, and
# fine for development. OSM's tile usage policy is explicitly NOT for a
# product with real users, so this must point somewhere else before launch.
#
# It used to point at CARTO with no key, and CARTO bakes
# "API KEY REQUIRED · carto.com/basemaps/apikey" into a sample of the tile
# images — a working map with an advert printed across it.
#
# MapTiler and Stadia both have free tiers. A self-hosted Protomaps file
# removes the per-request cost entirely and is the right answer if offline
# maps are wanted later.
#
# VITE_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# VITE_TILE_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
# VITE_TILE_SUBDOMAINS=
