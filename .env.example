# Supabase (required for multi-user cloud mode)
# 1. Create a project at https://supabase.com
# 2. Run supabase/schema.sql in the SQL Editor
# 3. Copy Project URL and anon public key from Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Crash reporting (optional). Without it the app runs exactly as before and
# nothing is sent anywhere. Create a project at https://sentry.io and paste its
# DSN here. Phone numbers, GPS coordinates and message text are stripped before
# any event leaves the device — see src/services/Monitoring.ts.
VITE_SENTRY_DSN=

# Stamped onto crash reports so a bug can be tied to the build it came from.
VITE_APP_VERSION=1.2
