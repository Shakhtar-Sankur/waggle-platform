<?xml version="1.0" encoding="utf-8"?>
<!--
  Buzz launcher foreground: the bee mark.

  Drawn inside the 108x108dp adaptive-icon canvas, with all meaning kept inside
  the centre ~72x72dp safe zone so no launcher mask (circle, squircle, rounded
  square) can clip it.

  The stripes are painted in the BACKGROUND orange rather than masked out —
  VectorDrawable has no <mask>, and the background layer is a flat #FF4400, so
  the result is identical and much simpler.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Left wing -->
    <group android:pivotX="32" android:pivotY="31" android:rotation="-38">
        <path
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.45"
            android:pathData="M19,31 a13,7.5 0 1,0 26,0 a13,7.5 0 1,0 -26,0 z" />
    </group>

    <!-- Right wing -->
    <group android:pivotX="76" android:pivotY="31" android:rotation="38">
        <path
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.45"
            android:pathData="M63,31 a13,7.5 0 1,0 26,0 a13,7.5 0 1,0 -26,0 z" />
    </group>

    <!-- Body capsule -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,34 a16,16 0 0,1 16,16 v14 a16,16 0 0,1 -16,16 a16,16 0 0,1 -16,-16 v-14 a16,16 0 0,1 16,-16 z" />

    <!-- Stripes, in the background colour. They run wider than the body; the
         overflow lands on the identical orange background and is invisible. -->
    <path android:fillColor="#FF4400" android:pathData="M32,46.5 h44 v5 h-44 z" />
    <path android:fillColor="#FF4400" android:pathData="M32,57.0 h44 v5 h-44 z" />
    <path android:fillColor="#FF4400" android:pathData="M32,67.5 h44 v5 h-44 z" />
</vector>
