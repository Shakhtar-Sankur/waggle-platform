<?xml version="1.0" encoding="utf-8"?>
<!--
  Buzz splash mark, animated.

  Geometric rather than illustrative, matching src/components/Wordmark.tsx: a
  honeycomb hexagon with two stripe cuts and two wing bars on the hexagon's own
  shoulder angle. The previous drawing was a literal bee whose soft elliptical
  wings turned to grey fuzz at launcher size.

  A copy of the launcher mark with named groups the animator targets: an
  adaptive icon cannot be an AnimatedVectorDrawable.

  All meaning stays inside the centre 72x72dp safe zone, so no launcher mask —
  circle, squircle, rounded square — can clip it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:name="bee"
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.72"
        android:scaleY="0.72">

    <!-- Wings: bars on the hexagon's own shoulder angle. -->
    <group android:name="wingLeft" android:pivotX="30.52" android:pivotY="39.15" android:rotation="-30">
        <path
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.5"
            android:pathData="M21.9,36.6 h17.25 v5.1 h-17.25 z" />
    </group>
    <group android:name="wingRight" android:pivotX="77.47" android:pivotY="39.15" android:rotation="30">
        <path
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.5"
            android:pathData="M68.85,36.6 h17.25 v5.1 h-17.25 z" />
    </group>

    <!-- Body: the same flat-topped hexagon as the in-app mark, scaled from the
         48-unit web grid onto the 108dp icon canvas (x1.5, centred), so the
         launcher icon and the mark inside the app are one drawing rather than
         two that drift. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54.0,38.25L71.25,48.38L71.25,68.62L54.0,78.75L36.75,68.62L36.75,48.38z" />

    <!-- Two cuts, in the background colour. VectorDrawable has no <mask>, and
         the layer beneath is a flat fill, so painting them is identical. -->
    <path android:fillColor="#4F46E5" android:pathData="M31.5,53.4 h45.0 v4.8 h-45.0 z" />
    <path android:fillColor="#4F46E5" android:pathData="M31.5,63.6 h45.0 v4.8 h-45.0 z" />
    </group>
</vector>
