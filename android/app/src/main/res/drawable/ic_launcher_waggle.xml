<?xml version="1.0" encoding="utf-8"?>
<!--
    The launcher foreground: the waggle run.

    Same geometry as the web mark in src/components/Wordmark.tsx, drawn on the
    same 48-unit grid and then scaled into the 108dp adaptive-icon viewport.
    Keep the two in step — if the path data here and there ever diverge, the
    icon and the header stop being the same logo.

    Adaptive icons are masked to a circle, a squircle or a rounded square
    depending on the launcher, and only the middle 72 of the 108 is guaranteed
    to survive. The group below scales the 48-unit artwork by 1.7 and centres
    it, which keeps the drawing well inside the safe zone on every mask.

    Strokes and one fill, and so no <mask> anywhere. That is the point of this
    drawing on Android: VectorDrawable has NO <mask> element, so the previous
    hexagon mark could not be ported honestly — its stripes had to be repainted
    in the background colour to fake the cut-out, which meant the icon quietly
    stopped working the moment the background was anything but that exact
    indigo. This version is the same artwork in both places.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- scale about the origin, then translate: 24,24 (the artwork's centre on
         the 48-grid) lands at 40.8,40.8 after the scale, so +13.2 on both axes
         puts it at 54,54, the centre of the 108 viewport. -->
    <group
        android:scaleX="1.7"
        android:scaleY="1.7"
        android:translateX="13.2"
        android:translateY="13.2">

        <!-- The run: a straight diagonal walked with a waggle, so it is drawn
             as a wave. The motion that names the app and the path she takes,
             in one stroke. -->
        <path
            android:pathData="M13.5,36.5 C 19.9,35.6 23,31.8 22.3,25.3 C 21.6,18.8 24.6,15 31,14"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="4.6"
            android:strokeLineCap="round" />

        <!-- The destination, seated on the end of the run. Drawn as two arcs
             because VectorDrawable has no <circle> element. -->
        <path
            android:pathData="M31,9.9 a4.1,4.1 0 1,1 0,8.2 a4.1,4.1 0 1,1 0,-8.2 Z"
            android:fillColor="#FFFFFF" />
    </group>
</vector>
