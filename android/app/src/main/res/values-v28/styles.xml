<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9 (API 28) and up: display cutouts.

  windowLayoutInDisplayCutoutMode arrived in API 28, so it cannot sit in the
  base bucket — the same mistake that made the navigation buttons invisible on
  Android 7 and 8. Phones older than this have no notch to reason about, so
  nothing is lost by leaving it out for them.

  shortEdges lets the coloured band run into the notch area rather than the
  system letterboxing around it, which is the whole point of drawing edge to
  edge on a phone that has one.
-->
<resources>
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>

        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar">true</item>

        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
