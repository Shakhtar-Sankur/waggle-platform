<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9 (API 28) and up. Edge to edge lives here and nowhere else.

  It was split across values-v27 and values-v28 for a morning, which created a
  version — Android 8.1 — that got the theme while index.html decided
  separately whether to send viewport-fit=cover. The two have to agree: the
  theme makes the window draw under the system bars, cover makes the web view
  lay out for that, and either one alone is wrong.

  One boundary now, and both sides of the change read it the same way: API 28
  here, `major >= 9` in the launch script. Android 7 and 8 keep the window they
  have always had, because that is the configuration their sign-in screen is
  known to work in and I cannot test those versions.
-->
<resources>
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>

        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar">true</item>

        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
