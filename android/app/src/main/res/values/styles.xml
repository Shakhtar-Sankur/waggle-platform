<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- Forced light: the app has no dark mode, so never follow system dark.

         NO edge-to-edge in this bucket, deliberately, and this is the second
         time that decision has had to be made.

         Drawing under the system bars broke the sign-in screen on Android 7 and
         8: with the keyboard open the web view was resized to the wrong height,
         so the form shrank to a strip at the top and the window's own white
         background filled everything between it and the keyboard. Sign-in is
         the first screen anyone sees and it was unusable.

         Edge-to-edge is a real improvement and it is verified working on a
         modern handset, so it lives in values-v27 where it was tested. These
         older releases keep exactly the layout they had before any of this
         started — which is the behaviour that was known to work. An app that
         fills the screen is worth having; an app you cannot sign in to is not,
         and I cannot test those versions from here. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <!-- Android 12+ splash API: the mark on Waggle indigo, animated.
             It was a still mark on a flat colour for as long as the web view
             took to boot, which on a cheap handset reads as a hang. -->
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_launcher_waggle</item>
        <item name="windowSplashScreenAnimationDuration">600</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
