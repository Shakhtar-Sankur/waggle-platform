<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- Forced light: the app has no dark mode, so never follow system dark. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>

        <!-- Edge to edge, which is the difference between an app and a web page
             in a box. The window was laid out INSIDE the system bars, so the
             coloured band stopped short of the top and a white strip sat above
             the navigation buttons.

             Transparent bars plus drawsSystemBarBackgrounds lets the app paint
             the full height; viewport-fit=cover in index.html is the other half,
             and without both the safe-area insets in the stylesheet read 0. -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- The band behind the status bar is the brand indigo on every screen
             that has one, so the clock and icons must be light. windowLightStatusBar
             false means light content, which reads correctly on indigo. -->
        <item name="android:windowLightStatusBar">false</item>

        <!-- The bottom nav is white, so the gesture pill has to be dark to be
             visible against it. Opposite of the status bar, deliberately. -->
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Use the notch area rather than letterboxing around it. -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <!-- Android 12+ splash API: the mark on Waggle indigo, animated.
             It was a still mark on a flat colour for as long as the web view
             took to boot, which on a cheap handset reads as a hang. -->
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_launcher_waggle</item>
        <item name="windowSplashScreenAnimationDuration">600</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>